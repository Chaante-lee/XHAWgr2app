<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#f4f6f8">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="114dp"
            android:background="#1f2d3d"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="49dp"
                android:layout_height="53dp"
                android:contentDescription="Logo"
                android:src="@drawable/_000118875" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Empowering the Nation"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/navHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#FF8C00"
                        android:padding="10dp"
                        android:text="Home"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/navQuote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#FF8C00"
                        android:padding="10dp"
                        android:text="Get Quote"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/navContact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#FF8C00"
                        android:padding="10dp"
                        android:text="Contact"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- MAIN CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Page Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Our Courses"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#2c3e50"
                android:layout_gravity="center"
                android:padding="35dp" />

            <!-- 6 WEEK COURSES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 Week short Courses"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#2c3e50"
                android:paddingBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast-track skill development - R750 per course"
                android:textColor="#2c3e50"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/navCourses6Week"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#040720"
                android:text="Browse 6 week Courses"
                android:textColor="#FFFFFF" />

            <!-- 6 MONTH COURSES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 Month Courses"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#2c3e50"
                android:paddingTop="16dp"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Advanced skill development programs - R1500 per course"
                android:textColor="#2c3e50"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/navCourses6Month"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#040720"
                android:text="Browse 6 month Courses"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>